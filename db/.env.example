# Copy to db/.env and adjust if needed.
# This URL is used by the scripts in db/scripts (goose, psql helpers) and by the
# Go API when DATABASE_URL is not set in the environment.
#
# NOTE: the host port is 5433 because a native PostgreSQL often owns 5432.
# See deploy/compose/docker-compose.yml.
DATABASE_URL=postgres://cutoptics:cutoptics@localhost:5433/cutoptics?sslmode=disable
